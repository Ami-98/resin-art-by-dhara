{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "RootPath": "../../data",
    "SeedSampleData": true,
    "UploadsRequestPath": "/uploads",
    "UploadsCacheMaxAgeSeconds": 604800,
    "BusinessSettingsFileName": "appsettings.Business.json",
    "Collections": {
      "Categories": "categories.json",
      "Products": "products.json",
      "PricingRules": "pricing-rules.json",
      "Contacts": "contacts.json",
      "CustomRequests": "custom-requests.json",
      "Counters": "counters.json",
      "AdminUsers": "admin-users.json"
    }
  },
  "Admin": {
    "InitialUserId": "adm_dhara",
    "InitialUsername": "dhara",
    "InitialPassword": "ResinArt@2026",
    "InitialDisplayName": "Dhara (Studio Owner)",
    "Role": "Admin",
    "CookieName": "ra_admin",
    "SessionExpireHours": 12,
    "SlidingExpiration": true,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "MinPasswordLength": 8
  },
  "Security": {
    "ApplicationName": "ResinArtByDhara",
    "PersistDataProtectionKeys": true,
    "ContentTypeOptions": "nosniff",
    "FrameOptions": "DENY",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "PermissionsPolicy": "geolocation=(self), camera=(self)"
  },
  "RateLimiting": {
    "Leads": {
      "PermitLimit": 15,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Uploads": {
      "PermitLimit": 25,
      "WindowSeconds": 300,
      "QueueLimit": 0
    }
  },
  "Uploads": {
    "MaxFileSizeMb": 8,
    "MaxFilesPerRequest": 5,
    "TempFilePrefix": "tmp_",
    "ReferenceFilePrefix": "ref_",
    "StripExifMetadata": true
  },
  "Catalog": {
    "DefaultCategory": "wall-clocks",
    "DefaultLeadTimeDays": 7,
    "DefaultBasePriceMinor": 199900,
    "PlaceholderImageUrl": "/uploads/placeholder.jpg",
    "FallbackSlug": "resin-piece"
  },
  "Maintenance": {
    "IntervalHours": 24,
    "KeepBackupsCount": 30,
    "OrphanedTempFileMaxAgeHours": 24,
    "MaxRecentSettingsBackups": 10
  },
  "Notifications": {
    "QueueCapacity": 256,
    "MaxRecentHistory": 100
  },
  "GeoIp": {
    "UseCloudflareHeader": true,
    "FallbackDatabase": "geo/GeoLite2-Country.mmdb",
    "DevCountryOverride": null
  },
  "Seo": {
    "PublicBaseUrl": "",
    "TitleSuffix": "Handcrafted Resin Art from Nadiad, Gujarat",
    "DefaultDescription": "Handcrafted luxury resin nameplates, varmala preservation wall clocks, Laddu Gopal Krishna jhulas, engagement ring platters and wedding keepsakes by Dhara Shah (Nadiad, Gujarat).",
    "DefaultImage": "/uploads/seed/grey-marble-ganesha-name-plate.jpg",
    "PlaceholderImage": "/uploads/seed/dhara-logo.jpg",
    "SitemapStaticPaths": [ "/", "/products", "/custom", "/contact" ],
    "RobotsDisallowPaths": [ "/admin", "/api" ]
  },
  "Business": {
    "Name": "Resin Delights by Dhara",
    "Tagline": "Preserving Memories in Resin",
    "Location": "Gujarat, India",
    "OwnerName": "Dhara Shah",
    "ContactEmail": "amee98123@gmail.com",
    "WhatsApp": {
      "Number": "+918758252673", 
      "BaseUrl": "https://wa.me/",
      "DefaultMessage": "✨ Hi Dhara! I'm interested in your handcrafted Resin Art and would love to know more. 🌸",
      "IncludeReference": false,
      "CustomerReplyTemplate": "Hi {name}, this is {owner} from {business} regarding your enquiry ({reference})."
